{
  "name": "cafe-claude",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test": "vitest",
    "db:migrate:dry-run": "tsx scripts/migrate-canonical-data.ts",
    "db:reconcile": "tsx scripts/migrate-canonical-data.ts",
    "db:rules:test": "npx firebase-tools emulators:exec --only auth,firestore --project demo-cafe-claude \"node scripts/validate-firestore-rules.mjs\"",
    "sync-chats": "powershell -ExecutionPolicy Bypass -File scripts/Sync-ChatsToObsidian.ps1",
    "storage:setup": "tsx scripts/setup-supabase-storage.ts",
    "storage:cleanup": "tsx scripts/cleanup-abandoned-uploads.ts",
    "storage:cleanup:dry": "tsx scripts/cleanup-abandoned-uploads.ts --dry-run",
    "demo:legacy-reset": "tsx scripts/reset-demo.ts",
    "demo:seed": "tsx scripts/demo/seedIlara.ts",
    "demo:reset": "tsx scripts/demo/resetIlara.ts",
    "demo:reseed": "npm run demo:reset && npm run demo:seed"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@notionhq/client": "^5.22.0",
    "@supabase/supabase-js": "^2.112.2",
    "@turf/distance": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "@turf/length": "^7.3.5",
    "@turf/line-slice": "^7.3.5",
    "@turf/nearest-point-on-line": "^7.3.5",
    "@turf/turf": "^7.3.5",
    "@types/leaflet": "^1.9.21",
    "@vladmandic/face-api": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^12.39.0",
    "h3-js": "^4.4.0",
    "leaflet": "^1.9.4",
    "leaflet-geosearch": "^4.4.0",
    "lucide-react": "^1.16.0",
    "next": "14.2.35",
    "nodemailer": "^8.0.7",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18",
    "react-dom": "^18",
    "react-leaflet": "^4.2.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^10.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "jsdom": "^29.1.1",
    "postcss": "^8",
